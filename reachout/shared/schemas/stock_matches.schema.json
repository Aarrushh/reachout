{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockMatches",
  "description": "Stage 03 output: shops from geo_shops that hold matching in-stock items right now. Facts copied from the DB and geo_shops only. Script invariants: match_count == matches.length; pinged_shop_ids == [m.shop_id for m in matches]; matches preserve the ranking nearest -> most matching stock -> cheapest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "enum": ["ok", "incomplete", "error"] },
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "raw_query copied from stage 01."
    },
    "query_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng", "resolved_from", "location_text"],
      "properties": {
        "lat": { "type": "number", "minimum": 40.2, "maximum": 40.7 },
        "lng": { "type": "number", "minimum": -4.0, "maximum": -3.4 },
        "resolved_from": { "enum": ["coordinates", "nominatim", "gazetteer", "default_center"] },
        "location_text": { "type": ["string", "null"] }
      },
      "description": "Copied verbatim from geo_shops.query_location."
    },
    "radius_km": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
    "match_count": { "type": "integer", "minimum": 0 },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shop_id", "shop_name", "categories", "address", "lat", "lng", "distance_km", "distance_type", "items"],
        "properties": {
          "shop_id": { "type": "string", "pattern": "^osm:(node|way|relation):[0-9]+$" },
          "shop_name": { "type": "string", "minLength": 1 },
          "categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["pharmacy", "grocery", "hardware", "electronics", "stationery"] }
          },
          "address": { "type": ["string", "null"] },
          "lat": { "type": "number", "minimum": 40.2, "maximum": 40.7 },
          "lng": { "type": "number", "minimum": -4.0, "maximum": -3.4 },
          "distance_km": { "type": "number", "minimum": 0 },
          "distance_type": { "enum": ["walking", "haversine"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sku", "name", "category", "price", "currency", "qty"],
              "properties": {
                "sku": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{4}$" },
                "name": { "type": "string", "minLength": 1 },
                "category": { "enum": ["pharmacy", "grocery", "hardware", "electronics", "stationery"] },
                "price": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
                "currency": { "const": "EUR" },
                "qty": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "minimum 1: out-of-stock rows are schema-invalid here by design."
                },
                "source": { "enum": ["template", "dummyjson"] },
                "rating": { "type": "number", "minimum": 0, "maximum": 5 },
                "review_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "pinged_shop_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^osm:(node|way|relation):[0-9]+$" }
    },
    "missing_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "enum": ["upstream_not_ok", "db_unavailable", "internal"] },
        "detail": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": {
        "required": ["query", "query_location", "radius_km", "match_count", "matches", "pinged_shop_ids"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "incomplete" } } },
      "then": { "required": ["missing_fields"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    }
  ]
}
