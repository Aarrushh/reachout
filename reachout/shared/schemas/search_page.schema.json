{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchPage",
  "description": "Paginated envelope for GET /api/search. The ranks stay the GLOBAL ranks (page 2 starts at rank 11). result_count equals the slice length.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "enum": ["ok", "incomplete", "error"] },
    "query": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "page": { "type": "integer", "minimum": 1 },
    "page_size": { "type": "integer", "minimum": 1, "maximum": 50 },
    "total_results": { "type": "integer", "minimum": 0 },
    "total_pages": { "type": "integer", "minimum": 0 },
    "result_count": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "shop_id", "shop_name", "category", "address", "distance_km", "item_name", "sku", "price", "currency", "stock_qty", "lat", "lng"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "shop_id": { "type": "string", "pattern": "^osm:(node|way|relation):[0-9]+$" },
          "shop_name": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["pharmacy", "grocery", "hardware", "electronics", "stationery"],
            "description": "Primary category (first of the shop's categories array)."
          },
          "address": { "type": ["string", "null"] },
          "distance_km": { "type": "number", "minimum": 0 },
          "item_name": { "type": "string", "minLength": 1 },
          "sku": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{4}$" },
          "price": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
          "currency": { "const": "EUR" },
          "stock_qty": { "type": "integer", "minimum": 1 },
          "lat": { "type": "number", "minimum": 40.2, "maximum": 40.7 },
          "lng": { "type": "number", "minimum": -4.0, "maximum": -3.4 }
        }
      }
    },
    "missing_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "enum": ["upstream_not_ok", "internal"] },
        "detail": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "required": ["query", "generated_at", "page", "page_size", "total_results", "total_pages", "result_count", "results"] }
    },
    {
      "if": { "properties": { "status": { "const": "incomplete" } } },
      "then": { "required": ["missing_fields"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    }
  ]
}
