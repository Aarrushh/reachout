# ReachOut backend v2 — copy to .env and fill in. .env is gitignored.

# Supabase project (https://supabase.com/dashboard → project settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_secret_...

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional — lets data/seed_inventory.py apply data/schema.sql automatically.
# Without either, run schema.sql once in the Supabase SQL editor instead.
# SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_ACCESS_TOKEN=sbp_...   # personal access token (Management API)

# Legacy v1 pipeline (optional, only for --use-llm query parsing)
# ANTHROPIC_API_KEY=...
# ANTHROPIC_BASE_URL=...

# ---------------------------------------------------------------------------
# Demand service (demand/). Reads this same file — demand/api/app.py calls
# load_dotenv() on reachout/.env, not on a file of its own.
# ---------------------------------------------------------------------------

# Which source GET /demand/api/analytics answers from. `live` reads Supabase;
# ANY other value — including unset, a typo, or an empty string — serves
# demand/api/fixtures/analytics_convenience_store.json labelled
# generated_from: "fixture", which the dashboard shows behind a "practice
# data" banner. It fails safe, not loud: a misspelling here does not error,
# it quietly serves canned data. If the dashboard shows the practice banner
# when you expected live data, check this spelling first.
# DEMAND_ANALYTICS_SOURCE=live

# SerpApi (https://serpapi.com/manage-api-key) — the Google Trends provider.
# PAID: 250 searches/month on the current plan and each call is billed, so no
# code path spends one implicitly. Live runs need --spend passed explicitly.
# Only needed to ingest new data; serving already-ingested data does not use it.
# SERPAPI_API_KEY=...

# Provider for demand/scripts/run_ingest.py when --provider is not passed.
# `serpapi` (default, paid) or `fixture` (free, for rehearsing a run).
# DEMAND_TRENDS_PROVIDER=serpapi

# Weekly in-process ingest cron (Mondays 00:00 UTC). Two switches on purpose:
# DEMAND_INGEST_CRON=1 alone only schedules nothing and prints why. Both must
# be 1 before the job runs, because each firing spends ~22 SerpApi searches
# (~88/month against the 250 cap). It also refuses to schedule if the process
# looks like one of several web workers, since each would ingest and multiply
# the spend. It only runs while the API process is up, and it passes no
# timeframe — so it maintains the 3-month series only; a 12-month refresh has
# to be run by hand.
# DEMAND_INGEST_CRON=1
# DEMAND_INGEST_CRON_SPEND=1
